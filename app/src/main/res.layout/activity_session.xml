<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/res/com"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Connection status bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:padding="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/connectionIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_wifi_connected"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Disconnected to opencode"
            android:textColor="?attr/onSurface"/>
    </LinearLayout>

    <!-- Output area - scrollable -->
    <androidx.core.widget.ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/colorSurfaceDark">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/outputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No session output yet\nConnect and start opencode on desktop"
                android:textSize="14sp"
                android:textColor="?attr/onSurfaceVariant"
                android:minLines="5"/>

            </LinearLayout>
    </androidx.core.widget.ScrollView>

    <!-- Command input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:padding="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:hint="Enter command (e.g., 'ls')"
            android:inputType="textPostalEmail"
            android:singleLine="true"/>

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="→"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>